# Copiar a .env y completar los valores.
APP_NAME=DocApp
APP_URL=http://localhost:3000
APP_PORT=3000

# Base de datos. En Podman el host es "db"; en desarrollo local puede ser 127.0.0.1.
DATABASE_URL=postgres://docapp:cambiar-esta-clave@db:5432/docapp
POSTGRES_DB=docapp
POSTGRES_USER=docapp
POSTGRES_PASSWORD=cambiar-esta-clave

# Secreto de la aplicación. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=cambiar-por-un-secreto-largo-y-aleatorio

# Administrador inicial. Solo se usa si la tabla de usuarios está vacía.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambiar-esta-clave-inicial
ADMIN_NAME=Administrador

UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=10
COOKIE_SECURE=false
# En desarrollo local con Edge instalado: msedge. En el contenedor: vacío.
PLAYWRIGHT_CHANNEL=
TZ=America/Asuncion
